# =========================================================================
# School Management System (SMS) - Environment Variables Template
# Copy this file to .env.local in the root directory and fill in the values.
# =========================================================================

# -------------------------------------------------------------------------
# 1. REQUIRED: Supabase Connection (Database & Authentication)
# -------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public API anonymous key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your Supabase Service Role Key (secret key, KEEP SECURE, used for server-side admin actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------------------
# 2. OPTIONAL: Feature-Specific Integrations
# -------------------------------------------------------------------------

# OpenAI API Key (Required for AI academic summaries)
OPENAI_API_KEY=sk-xxx

# Loops API Key (Required for automated email notifications)
LOOPS_API_KEY=your-loops-api-key

# Paynow Integration credentials (Required for fee payment simulator and webhook processing)
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key

# Trigger.dev Secret Key (For background task queues and job management - currently disabled/commented out)
TRIGGER_SECRET_KEY=tr_dev_xxx

# Sentry Configuration (For application monitoring and error logging - currently not implemented)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
